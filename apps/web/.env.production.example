# Variables du service web en production (Railway → service "web" → Variables).
# NEXT_PUBLIC_* est lu au BUILD : Railway les passe en build-arg automatiquement.
# Toute modification impose un redéploiement (rebuild) du service web.

# URL publique de l'API, suffixe /api/v1 inclus.
NEXT_PUBLIC_API_URL="https://avenloc-api.up.railway.app/api/v1"

# Clé publiable Stripe (pk_test_… en démo). Laisser vide si paiement simulé.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
