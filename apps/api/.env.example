# ── Base de données ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://aven_user:aven_password@localhost:5432/aven_db?schema=public"

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-in-production-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-in-production-refresh"
JWT_REFRESH_EXPIRES_IN="30d"

# ── OAuth Google (optionnel) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# ── Stripe (OBLIGATOIRE pour les paiements) ──────────────────────────────────
# Clé : https://dashboard.stripe.com/test/apikeys  •  Connect : https://dashboard.stripe.com/test/connect
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PLATFORM_ACCOUNT_ID=""

# ── Stockage des photos ──────────────────────────────────────────────────────
# Par défaut : disque local dans apps/api/uploads, servi sur /uploads. Rien à configurer.
# UPLOADS_DIR=""                       # dossier custom (défaut : <cwd>/uploads)
# API_PUBLIC_URL="http://localhost:3001"  # base d'URL des fichiers locaux

# S3 / S3-compatible : utilisé UNIQUEMENT si S3_ACCESS_KEY_ID est renseigné.
S3_ENDPOINT=""
S3_REGION="eu-west-3"
S3_BUCKET="aven-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# ── Feature flags (démo / dev) ───────────────────────────────────────────────
# Flags actifs au démarrage (liste séparée par des virgules). Ex : "simulatePayments"
# simulatePayments : contourne Stripe (onboarding + encaissement fictifs) pour
#                    dérouler tous les parcours sans configuration Stripe.
FEATURES=""
# Autorise le toggle à chaud via PATCH /features et la barre "⚙︎ Démo" du front.
# Actif hors production par défaut ; passer à "false" en prod.
FEATURES_ADMIN="true"

# ── Elasticsearch (optionnel — V2) ────────────────────────────────────────────
ELASTICSEARCH_URL=""
ELASTICSEARCH_INDEX_LISTINGS="listings"
