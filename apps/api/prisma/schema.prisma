generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

/// Seed: pnpm --filter @aven/api exec ts-node prisma/seed.ts

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, btree_gist, pgcrypto]
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum UserRole {
  TENANT
  HOST
  COMMERCIAL
  ADMIN
  // Peut modifier/dépublier/supprimer n'importe quelle annonce (modération de
  // contenu), quel que soit son propriétaire. Pour l'instant, COMMERCIAL a
  // aussi ces droits en pratique (voir listings.service.ts `canModerate`) —
  // le temps qu'une équipe modération dédiée existe.
  MODERATOR
}

enum IdentityStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ListingType {
  APARTMENT
  HOUSE
  ROOM
  OFFICE
  MEETING_ROOM
  WORKSHOP
  WAREHOUSE
  EVENT_SPACE
  PARKING
  SHOP
  PRACTICE_ROOM
  RESTAURANT
  CREATIVE_STUDIO
  OTHER
}

enum PricingUnit {
  NIGHT
  HOUR
  DAY
}

enum AccessMethod {
  CONNECTED_LOCK // serrure connectée, déverrouillage à distance depuis la confirmation
  ACCESS_CODE // code numérique communiqué à la confirmation
  KEY_BOX // boîte à clés sécurisée sur place
  QR_CODE // QR code scanné à l'arrivée
  RECEPTION // remise en main propre par un accueil
}

enum CancellationPolicy {
  FLEXIBLE // remboursement si annulation > 24h avant
  MODERATE // remboursement si annulation > 5 jours avant
  STRICT // remboursement 50% si annulation > 7 jours avant
  NON_REFUNDABLE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  // Fiche créée pour un hôte par un commercial (visite terrain) : en attente que
  // l'hôte se connecte, relise et complète l'annonce avant de la publier lui-même.
  PENDING_VALIDATION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum MessageSenderRole {
  TENANT
  HOST
}

// Cycle de vie de la caution (empreinte bancaire) — voir note-technique-caution.md.
// Pas de valeur "NONE" : l'absence de ligne Deposit signifie qu'aucune caution
// n'est requise pour cette réservation.
enum DepositStatus {
  AUTHORIZED // empreinte posée, fonds bloqués mais non débités
  CAPTURE_REQUESTED // l'hôte a demandé une capture — le locataire a 48h pour contester
  CAPTURED // capture effectuée (totale ou partielle, voir capturedAmount)
  CONTESTED // contestée par le locataire — en attente de médiation manuelle
  RELEASED // empreinte libérée sans capture (fin de séjour sans réclamation)
  EXPIRED // empreinte expirée chez le prestataire avant d'avoir pu être traitée
}

enum ReviewTarget {
  LISTING // locataire note le local
  TENANT // hôte note le locataire
}

enum HostInvitationStatus {
  SENT // lien d'activation envoyé, en attente que l'hôte crée son mot de passe
  ACCEPTED // compte hôte activé
  EXPIRED // délai d'activation dépassé
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String         @unique
  hashedPassword String? // null si OAuth uniquement
  firstName      String
  lastName       String
  avatarUrl      String?
  bio            String?
  phone          String?
  roles          UserRole[]     @default([TENANT])
  identityStatus IdentityStatus @default(UNVERIFIED)
  identityData   Json? // stub KYC : champs réservés, non implémentés en V1

  // Stripe Connect (rôle hôte)
  stripeAccountId     String? @unique
  stripeAccountStatus String? // "pending" | "active" | "restricted"
  payoutLast4         String? // 4 derniers chiffres de l'IBAN de versement
  payoutHolderName    String? // titulaire du compte bancaire

  // Stripe (rôle locataire)
  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthAccounts    OAuthAccount[]
  refreshTokens    RefreshToken[]
  listings         Listing[]
  bookingsAsTenant Booking[]      @relation("TenantBookings")
  sentMessages     Message[]
  reviews          Review[]       @relation("ReviewAuthor")
  receivedReviews  Review[]       @relation("ReviewSubject")

  conversationsAsTenant Conversation[] @relation("ConversationTenant")
  conversationsAsHost   Conversation[] @relation("ConversationHost")

  // Module Commercial : établissements possédés (en tant qu'hôte) vs créés (en tant que commercial).
  establishments        Establishment[]  @relation("EstablishmentHost")
  establishmentsCreated Establishment[]  @relation("EstablishmentCreatedBy")
  hostInvitationsSent   HostInvitation[] @relation("HostInvitationCommercial")

  @@index([email])
}

model OAuthAccount {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique // SHA-256 du token brut stocké, jamais le token en clair
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── PLATFORM CONFIG ──────────────────────────────────────────────────────────

// Singleton : une seule ligne en production (id = 'default').
// Modifiable par un admin via API protégée — pas de migration si le taux global change.
// Lecture mise en cache Redis (clé "platform:config", TTL 5 min) — invalidée à chaque update.
model PlatformConfig {
  id                      String   @id @default("default")
  serviceFeeRate          Decimal  @default(0.1200) @db.Decimal(5, 4) // 12% par défaut
  taxRate                 Decimal  @default(0.2000) @db.Decimal(5, 4) // TVA 20% par défaut
  currency                String   @default("EUR")
  // Fenêtre de validation hôte (en heures) pour les réservations non-instant-book.
  // Au-delà, le job de nettoyage annule automatiquement la réservation PENDING.
  hostApprovalWindowHours Int      @default(24)
  updatedAt               DateTime @updatedAt
}

// Snapshot horodaté à chaque modification de PlatformConfig.
// Source de vérité pour les audits comptables et légaux sur les taux appliqués.
// Jamais modifiée ni supprimée (append-only).
model PlatformConfigHistory {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceFeeRate          Decimal  @db.Decimal(5, 4)
  taxRate                 Decimal  @db.Decimal(5, 4)
  hostApprovalWindowHours Int
  currency                String
  changedAt               DateTime @default(now())
  changedBy               String?  @db.Uuid // userId admin — null si changement système
}

// Interrupteurs de fonctionnalités (ex. paiements Stripe réels vs simulés).
// Singleton persistant — seul un compte ADMIN peut les modifier (PATCH /features).
// Un cache en mémoire évite un aller-retour base à chaque lecture (FeaturesService).
model FeatureFlagState {
  id        String   @id @default("default")
  flags     Json
  updatedAt DateTime @updatedAt
}

// ─── LISTINGS ─────────────────────────────────────────────────────────────────

model Listing {
  id     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostId String        @db.Uuid
  type   ListingType
  status ListingStatus @default(DRAFT)

  // Date de vérification de cet espace par la plateforme ; indépendante du statut de publication et de l’identité de l’hôte.
  verifiedAt DateTime? @db.Timestamptz

  title       String
  description String

  // Adresse
  addressLine1 String
  addressLine2 String?
  city         String
  postalCode   String
  country      String  @default("FR")

  // Coordonnées stockées en Float pour Prisma ORM.
  // Une colonne PostGIS `location geometry(Point, 4326)` est maintenue en synchrone
  // via un trigger SQL (INSERT + UPDATE) — voir migration 0002_postgis_geometry.sql.
  latitude  Float
  longitude Float

  // Capacité humaine, uniquement pour les types habitables (APARTMENT, HOUSE, ROOM).
  // Pour les surfaces (m²), places de parking, hauteur sous plafond → specificAttributes.
  maxGuests Int?

  pricingUnit PricingUnit
  basePrice   Decimal     @db.Decimal(10, 2)
  cleaningFee Decimal?    @db.Decimal(10, 2)

  // Caution (empreinte bancaire, jamais débitée par défaut) — voir modèle Deposit.
  // Null/0 = aucune caution demandée pour cette annonce.
  depositAmount Decimal? @db.Decimal(10, 2)

  // Override ponctuel du taux de commission.
  // Si null → on utilise PlatformConfig.serviceFeeRate au moment du calcul.
  // Permet des taux négociés par annonce ou par palier d'hôte sans migrer toutes les lignes.
  serviceFeeRateOverride Decimal? @db.Decimal(5, 4)

  cancellationPolicy CancellationPolicy @default(MODERATE)

  // Instant Book : si true, la réservation est confirmée automatiquement dès paiement autorisé.
  // Si false : statut PENDING jusqu'à validation explicite de l'hôte (voir Booking.hostApprovalDeadline).
  // Impact Stripe : false → capture_method: 'manual' sur le PaymentIntent (autorisation différée).
  instantBookEnabled Boolean @default(false)

  // ── Créneaux horaires ────────────────────────────────────────────────────────
  // Horaires d'ouverture hebdomadaires utilisés pour générer la grille de créneaux
  // réservables (voir availability-rules.util.ts côté API). openDays : 0=dimanche..6=samedi.
  openDays           Int[]  @default([1, 2, 3, 4, 5])
  openStartTime      String @default("08:00") // "HH:mm", heure locale Europe/Paris
  openEndTime        String @default("19:00")
  minDurationMinutes Int    @default(60)
  minNoticeHours     Int    @default(0) // délai minimum avant le début du créneau pour réserver

  // ── Conditions d'accès et d'usage ────────────────────────────────────────────
  accessMethod               AccessMethod?
  accessInstructions         String? // code / lien / consignes — révélé seulement après confirmation
  activityValidationRequired Boolean       @default(false) // l'hôte doit valider manuellement l'activité prévue
  rcProRequired              Boolean       @default(false) // assurance RC Pro exigée du locataire
  houseRules                 String? // règlement intérieur affiché avant réservation

  // Tags normalisés — valeurs contrôlées par une enum applicative (non Prisma)
  amenities String[]

  // Attributs spécifiques au type de local — exemples par type :
  //   APARTMENT / HOUSE  : { "floor": 3, "elevator": true, "balcony": false }
  //   MEETING_ROOM       : { "projector": true, "whiteboard": true, "capacity_persons": 12 }
  //   WAREHOUSE          : { "surface_m2": 500, "height_m": 6.5, "loading_dock": true }
  //   PARKING            : { "spots": 2, "covered": true, "ev_charger": false }
  //   OFFICE             : { "surface_m2": 25, "standing_desk": true }
  specificAttributes Json?

  // Rattachement optionnel à un établissement (regroupement créé via le module Commercial).
  establishmentId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host            User                  @relation(fields: [hostId], references: [id])
  establishment   Establishment?        @relation(fields: [establishmentId], references: [id])
  photos          ListingPhoto[]
  availabilities  ListingAvailability[]
  faqItems        ListingFaqItem[]
  bookings        Booking[]
  reviews         Review[]
  conversations   Conversation[]
  hostInvitations HostInvitation[]

  @@index([hostId])
  @@index([type])
  @@index([city])
  @@index([basePrice])
  @@index([status])
  @@index([establishmentId])
}

// FAQ libre par annonce (question/réponse), affichée sur la fiche.
model ListingFaqItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String   @db.Uuid
  question  String
  answer    String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model ListingPhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String   @db.Uuid
  url       String // clé S3 (pas l'URL signée — celle-ci est générée à la volée)
  position  Int      @default(0)
  caption   String?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// Blocages ou exceptions ponctuelles définis par l'hôte, en plus des horaires
// d'ouverture récurrents (Listing.openDays/openStartTime/openEndTime).
// isAvailable = false → fermeture manuelle (déplacement personnel, travaux, jour férié, etc.)
model ListingAvailability {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId   String   @db.Uuid
  startAt     DateTime @db.Timestamptz // horodatage précis, pas seulement une date
  endAt       DateTime @db.Timestamptz // exclusif, même convention que Booking
  isAvailable Boolean  @default(true)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// ─── BOOKINGS ─────────────────────────────────────────────────────────────────

model Booking {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String        @db.Uuid
  tenantId  String        @db.Uuid
  status    BookingStatus @default(PENDING)

  // Réservation par créneau horaire. Convention endAt EXCLUSIF : le créneau
  // couvre [startAt, endAt[. Exemple : 14h-16h le 10 juillet 2026 →
  // startAt 2026-07-10T14:00:00+02:00, endAt 2026-07-10T16:00:00+02:00 → 2 heures.
  // Contrainte CHECK (startAt < endAt) garantie en migration brute (0003/0006).
  startAt DateTime @db.Timestamptz
  endAt   DateTime @db.Timestamptz

  // unitCount = nombre d'unités facturées (heures, nuits ou jours selon Listing.pricingUnit).
  unitCount Int

  // ── Snapshot financier ──────────────────────────────────────────────────────
  // Ces montants sont figés au moment où la réservation passe en CONFIRMED.
  // Ils ne changent pas si l'hôte modifie son annonce après coup.
  //
  // Booking.serviceFee : montant calculé par la logique métier au moment de la réservation.
  // Payment.platformFee : montant effectivement prélevé par Stripe lors de la capture.
  // Les deux coexistent volontairement — voir ARCHITECTURE.md §"Booking vs Payment".
  baseAmount  Decimal @db.Decimal(10, 2)
  cleaningFee Decimal @default(0) @db.Decimal(10, 2)
  serviceFee  Decimal @db.Decimal(10, 2)
  taxAmount   Decimal @default(0) @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)

  guestCount  Int     @default(1)
  guestNote   String? // message / instructions du locataire pour l'hôte
  arrivalTime String? // heure d'arrivée prévue (ex. "14:30")

  // Renseignés à la réservation lorsque l'annonce l'exige (voir Listing.activityValidationRequired
  // / rcProRequired) — conservés tels quels même si l'annonce change ensuite.
  activityDescription String?
  rcProAccepted       Boolean @default(false)
  houseRulesAccepted  Boolean @default(false)

  // Deadline de validation hôte. Null si Listing.instantBookEnabled = true.
  // Calculé à la création : now() + PlatformConfig.hostApprovalWindowHours.
  // Le job de nettoyage annule les PENDING dont hostApprovalDeadline est dépassée.
  hostApprovalDeadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing  Listing   @relation(fields: [listingId], references: [id])
  tenant   User      @relation("TenantBookings", fields: [tenantId], references: [id])
  payment  Payment?
  deposit  Deposit?
  messages Message[]
  reviews  Review[]

  @@index([listingId])
  @@index([tenantId])
  @@index([status])
  @@index([listingId, startAt, endAt])
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

model Payment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String        @unique @db.Uuid
  status    PaymentStatus @default(PENDING)

  stripePaymentIntentId String? @unique
  stripeTransferId      String? // Transfer Stripe vers le compte Connect de l'hôte
  stripeRefundId        String?

  amount         Decimal @db.Decimal(10, 2) // = Booking.totalAmount
  platformFee    Decimal @db.Decimal(10, 2) // commission effectivement prélevée par Stripe
  hostPayout     Decimal @db.Decimal(10, 2) // = amount - platformFee (net reçu par l'hôte)
  refundedAmount Decimal @default(0) @db.Decimal(10, 2)

  currency   String    @default("EUR")
  capturedAt DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ─── CAUTION (DEPOSIT) ────────────────────────────────────────────────────────
// Pré-autorisation bancaire distincte du paiement du séjour — voir
// note-technique-caution.md. Une ligne n'existe que si Listing.depositAmount
// était renseigné au moment de la réservation.
model Deposit {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String        @unique @db.Uuid
  status    DepositStatus @default(AUTHORIZED)

  amount Decimal @db.Decimal(10, 2) // montant de l'empreinte posée

  stripePaymentIntentId String? @unique // PaymentIntent dédié, capture_method "manual"

  authorizedAt DateTime? // pose de l'empreinte
  expiresAt    DateTime? // durée de vie donnée par Stripe (~7 jours) — sert au job de renouvellement

  // ── Réclamation hôte ─────────────────────────────────────────────────────
  captureReason      String? // motif : dégradation, no-show, retard, dépassement…
  captureRequestedAt DateTime? // point de départ du délai de contestation (48h)
  proofUrls          String[]  @default([]) // preuves photo jointes par l'hôte

  // ── Résolution ───────────────────────────────────────────────────────────
  capturedAmount Decimal?  @db.Decimal(10, 2) // montant réellement capturé (≤ amount)
  capturedAt     DateTime?
  contestReason  String? // motif de contestation du locataire
  contestedAt    DateTime?
  releasedAt     DateTime? // libération sans capture

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([status])
}

// ─── MESSAGING ────────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String?  @unique @db.Uuid // null = conversation pré-réservation (question sur l'annonce)
  listingId String   @db.Uuid
  tenantId  String   @db.Uuid
  hostId    String   @db.Uuid
  createdAt DateTime @default(now())

  messages Message[]
  listing  Listing   @relation(fields: [listingId], references: [id])
  tenant   User      @relation("ConversationTenant", fields: [tenantId], references: [id])
  host     User      @relation("ConversationHost", fields: [hostId], references: [id])

  @@index([tenantId])
  @@index([hostId])
  @@index([listingId])
}

model Message {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String            @db.Uuid
  senderId       String            @db.Uuid
  senderRole     MessageSenderRole
  content        String
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  bookingId      String?           @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
  booking      Booking?     @relation(fields: [bookingId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

// ─── REVIEWS ──────────────────────────────────────────────────────────────────

model Review {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String       @db.Uuid
  authorId  String       @db.Uuid
  target    ReviewTarget

  rating   Int // 1 à 5 — validé au niveau applicatif (1 ≤ rating ≤ 5)
  comment  String?
  criteria String? // critères évalués, texte libre (ex. "Propreté, conformité, accès")
  isPublic Boolean @default(true)

  // Relation polymorphique : exactement l'un des deux est non-null selon target.
  //   target = LISTING → listingId non-null, tenantSubjectId null
  //   target = TENANT  → tenantSubjectId non-null, listingId null
  // Invariant vérifié au niveau service, pas de contrainte CHECK en base
  // (PostgreSQL ne supporte pas les CHECK inter-colonnes avec FK).
  listingId       String? @db.Uuid
  tenantSubjectId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking       Booking  @relation(fields: [bookingId], references: [id])
  author        User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  listing       Listing? @relation(fields: [listingId], references: [id])
  tenantSubject User?    @relation("ReviewSubject", fields: [tenantSubjectId], references: [id])

  // Un seul avis par booking et par direction (locataire→local ou hôte→locataire)
  @@unique([bookingId, authorId, target])
  @@index([bookingId])
  @@index([authorId])
  @@index([listingId])
}

// ─── COMMERCIAL ───────────────────────────────────────────────────────────────
// Regroupement d'annonces créées lors d'une visite terrain par un commercial pour
// le compte d'un hôte (ex. plusieurs salles dans un même immeuble). L'hôte n'a
// pas forcément de compte au moment de la création — voir HostInvitation.
model Establishment {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostId      String @db.Uuid
  createdById String @db.Uuid // le commercial à l'origine de la fiche

  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  postalCode   String
  country      String  @default("FR")
  latitude     Float?
  longitude    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host        User             @relation("EstablishmentHost", fields: [hostId], references: [id])
  createdBy   User             @relation("EstablishmentCreatedBy", fields: [createdById], references: [id])
  listings    Listing[]
  invitations HostInvitation[]

  @@index([hostId])
  @@index([createdById])
}

// Invitation envoyée par un commercial à un hôte rencontré sur le terrain pour
// qu'il active son compte et reprenne la main sur la fiche pré-remplie.
// Pas d'envoi d'email réel (aucun mailer dans le projet) : même pattern que
// AuthService.forgotPassword — le lien est loggé et renvoyé en clair hors production.
model HostInvitation {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  establishmentId String               @db.Uuid
  listingId       String?              @db.Uuid
  commercialId    String               @db.Uuid
  status          HostInvitationStatus @default(SENT)

  hostEmail     String
  hostFirstName String?
  hostLastName  String?
  hostPhone     String?

  token      String    @unique
  sentAt     DateTime  @default(now())
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  listing       Listing?      @relation(fields: [listingId], references: [id])
  commercial    User          @relation("HostInvitationCommercial", fields: [commercialId], references: [id])

  @@index([establishmentId])
  @@index([commercialId])
  @@index([hostEmail])
}
