generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

/// Seed: pnpm --filter @aven/api exec ts-node prisma/seed.ts

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, btree_gist, pgcrypto]
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum UserRole {
  TENANT
  HOST
}

enum IdentityStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

// Types d'espaces professionnels proposés à la location — pas de résidentiel
// (appartement/maison/chambre) ni de stockage (entrepôt/parking) : hors périmètre produit.
enum ListingType {
  OFFICE
  MEETING_ROOM
  TRAINING_ROOM
  WORKSHOP
  EVENT_SPACE
  BOUTIQUE
  CABINET
  RESTAURANT
  DESK           // "fauteuil vacant" — poste/place unique dans un espace partagé
  CREATIVE_STUDIO
  OTHER
}

enum PricingUnit {
  NIGHT
  HOUR
  DAY
}

enum CancellationPolicy {
  FLEXIBLE       // remboursement 100% si annulation > 24h avant
  MODERATE       // remboursement 100% si > 3 jours avant, 50% si > 24h avant
  STRICT         // remboursement 50% si annulation > 7 jours avant
  NON_REFUNDABLE
}

// Méthode de remise des instructions d'accès après confirmation du paiement —
// voir AccessMethodBlock dans le design de référence.
enum AccessMethod {
  CODE        // code temporaire affiché sur la page de confirmation
  QR          // QR code à scanner sur place
  KEYBOX      // boîte à clés
  SMART_LOCK  // serrure connectée, déverrouillage à distance
  RECEPTION   // accueil sur place, réservation enregistrée au nom du locataire
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum MessageSenderRole {
  TENANT
  HOST
}

// Cycle de vie de la caution (empreinte bancaire) — voir note-technique-caution.md.
// Pas de valeur "NONE" : l'absence de ligne Deposit signifie qu'aucune caution
// n'est requise pour cette réservation.
enum DepositStatus {
  AUTHORIZED        // empreinte posée, fonds bloqués mais non débités
  CAPTURE_REQUESTED // l'hôte a demandé une capture — le locataire a 48h pour contester
  CAPTURED          // capture effectuée (totale ou partielle, voir capturedAmount)
  CONTESTED         // contestée par le locataire — en attente de médiation manuelle
  RELEASED          // empreinte libérée sans capture (fin de séjour sans réclamation)
  EXPIRED           // empreinte expirée chez le prestataire avant d'avoir pu être traitée
}

enum ReviewTarget {
  LISTING // locataire note le local
  TENANT  // hôte note le locataire
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String         @unique
  hashedPassword String?        // null si OAuth uniquement
  firstName      String
  lastName       String
  avatarUrl      String?
  bio            String?
  phone          String?
  roles          UserRole[]     @default([TENANT])
  identityStatus IdentityStatus @default(UNVERIFIED)
  identityData   Json?          // stub KYC : champs réservés, non implémentés en V1

  // Stripe Connect (rôle hôte)
  stripeAccountId     String? @unique
  stripeAccountStatus String? // "pending" | "active" | "restricted"
  payoutLast4         String? // 4 derniers chiffres de l'IBAN de versement
  payoutHolderName    String? // titulaire du compte bancaire

  // Stripe (rôle locataire)
  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthAccounts    OAuthAccount[]
  refreshTokens    RefreshToken[]
  listings         Listing[]
  bookingsAsTenant Booking[]      @relation("TenantBookings")
  sentMessages     Message[]
  reviews          Review[]       @relation("ReviewAuthor")
  receivedReviews  Review[]       @relation("ReviewSubject")

  conversationsAsTenant Conversation[] @relation("ConversationTenant")
  conversationsAsHost   Conversation[] @relation("ConversationHost")

  @@index([email])
}

model OAuthAccount {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique // SHA-256 du token brut stocké, jamais le token en clair
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── PLATFORM CONFIG ──────────────────────────────────────────────────────────

// Singleton : une seule ligne en production (id = 'default').
// Modifiable par un admin via API protégée — pas de migration si le taux global change.
// Lecture mise en cache Redis (clé "platform:config", TTL 5 min) — invalidée à chaque update.
model PlatformConfig {
  id                     String   @id @default("default")
  serviceFeeRate         Decimal  @db.Decimal(5, 4) @default(0.1200) // 12% par défaut
  taxRate                Decimal  @db.Decimal(5, 4) @default(0.2000) // TVA 20% par défaut
  currency               String   @default("EUR")
  // Fenêtre de validation hôte (en heures) pour les réservations non-instant-book.
  // Au-delà, le job de nettoyage annule automatiquement la réservation PENDING.
  hostApprovalWindowHours Int     @default(24)
  updatedAt              DateTime @updatedAt
}

// Snapshot horodaté à chaque modification de PlatformConfig.
// Source de vérité pour les audits comptables et légaux sur les taux appliqués.
// Jamais modifiée ni supprimée (append-only).
model PlatformConfigHistory {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceFeeRate         Decimal  @db.Decimal(5, 4)
  taxRate                Decimal  @db.Decimal(5, 4)
  hostApprovalWindowHours Int
  currency               String
  changedAt              DateTime @default(now())
  changedBy              String?  @db.Uuid // userId admin — null si changement système
}

// ─── LISTINGS ─────────────────────────────────────────────────────────────────

model Listing {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostId      String        @db.Uuid
  type        ListingType
  status      ListingStatus @default(DRAFT)

  title       String
  description String

  // Adresse
  addressLine1 String
  addressLine2 String?
  city         String
  postalCode   String
  country      String @default("FR")

  // Coordonnées stockées en Float pour Prisma ORM.
  // Une colonne PostGIS `location geometry(Point, 4326)` est maintenue en synchrone
  // via un trigger SQL (INSERT + UPDATE) — voir migration 0002_postgis_geometry.sql.
  latitude  Float
  longitude Float

  // Capacité (personnes, postes, couverts… selon le type — voir capacityNoun côté front).
  // Pour les autres mesures (surface, hauteur sous plafond…) → specificAttributes.
  maxGuests Int?

  pricingUnit PricingUnit
  basePrice   Decimal     @db.Decimal(10, 2)
  cleaningFee Decimal?    @db.Decimal(10, 2)

  // Caution (empreinte bancaire, jamais débitée par défaut) — voir modèle Deposit.
  // Null/0 = aucune caution demandée pour cette annonce.
  depositAmount Decimal? @db.Decimal(10, 2)

  // Override ponctuel du taux de commission.
  // Si null → on utilise PlatformConfig.serviceFeeRate au moment du calcul.
  // Permet des taux négociés par annonce ou par palier d'hôte sans migrer toutes les lignes.
  serviceFeeRateOverride Decimal? @db.Decimal(5, 4)

  cancellationPolicy CancellationPolicy @default(MODERATE)

  // Assurance responsabilité civile professionnelle exigée pour réserver.
  // Si true, le locataire doit cocher une confirmation à la réservation
  // (voir Booking.rcProConfirmed) — bloquant tant que non coché.
  rcProRequired Boolean @default(false)

  // Règlement intérieur affiché sur la fiche. Si non-null, le locataire doit
  // cocher son acceptation à la réservation (voir Booking.houseRulesAccepted).
  houseRules String?

  // FAQ de l'annonce — liste de { question, réponse }. Générée automatiquement
  // à la création (wizard commercial ou hôte) puis éditable librement.
  // Ex. [{ "question": "Le café est-il inclus ?", "reponse": "Oui, en libre-service." }]
  faq Json?

  // Instant Book : si true, la réservation est confirmée automatiquement dès paiement autorisé.
  // Si false : statut PENDING jusqu'à validation explicite de l'hôte (voir Booking.hostApprovalDeadline).
  // Impact Stripe : false → capture_method: 'manual' sur le PaymentIntent (autorisation différée).
  instantBookEnabled Boolean @default(false)

  // true si la fiche a été créée par un commercial pour le compte de cet hôte
  // (voir POST /listings/commercial) — affiche une bannière de vérification tant
  // que l'hôte n'a pas lui-même enregistré une modification sur l'annonce.
  createdByCommercial Boolean @default(false)

  // ── Accès (affiché au locataire uniquement après paiement confirmé) ────────
  accessMethod    AccessMethod @default(CODE)
  accessCode      String?      // code temporaire ou code de la boîte à clés
  wifiName        String?
  wifiPassword    String?
  contactPhone    String?      // contact sur place, indicatif si différent du téléphone du profil hôte

  // Tags libres saisis par l'hôte ou le commercial (ex. "Wi-Fi", "Terrasse").
  // Aucune enum fermée n'est appliquée côté validation (CreateListingDto) —
  // le commentaire précédent suggérant une liste contrôlée était erroné/aspirationnel.
  amenities String[]

  // Attributs spécifiques au type de local — exemples par type :
  //   APARTMENT / HOUSE  : { "floor": 3, "elevator": true, "balcony": false }
  //   MEETING_ROOM       : { "projector": true, "whiteboard": true, "capacity_persons": 12 }
  //   WAREHOUSE          : { "surface_m2": 500, "height_m": 6.5, "loading_dock": true }
  //   PARKING            : { "spots": 2, "covered": true, "ev_charger": false }
  //   OFFICE             : { "surface_m2": 25, "standing_desk": true }
  //   BOUTIQUE           : { "surface_m2": 30, "shopfront": true, "storage_room": false }
  //   CABINET            : { "waiting_room": true, "soundproof": true }
  //   RESTAURANT         : { "seats": 40, "kitchen_equipped": true, "terrace": false }
  //   DESK               : { "monitor": true, "standing_desk": false }
  //   CREATIVE_STUDIO    : { "lighting_kit": true, "backdrop_colors": ["white", "black"] }
  specificAttributes Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host           User                  @relation(fields: [hostId], references: [id])
  photos         ListingPhoto[]
  availabilities ListingAvailability[]
  availabilityRules ListingAvailabilityRule[]
  bookings       Booking[]
  reviews        Review[]
  conversations  Conversation[]

  @@index([hostId])
  @@index([type])
  @@index([city])
  @@index([basePrice])
  @@index([status])
}

model ListingPhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String   @db.Uuid
  url       String   // clé S3 (pas l'URL signée — celle-ci est générée à la volée)
  position  Int      @default(0)
  caption   String?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// Fenêtres de disponibilité définies par l'hôte.
// isAvailable = false → blocage manuel (déplacement personnel, travaux, etc.)
// Précision timestamp (et non date) depuis la migration 0007 : nécessaire pour
// bloquer des créneaux horaires précis sur les annonces pricingUnit = HOUR. Pour
// NIGHT/DAY, l'heure reste à 00:00 par convention (posée par le front), donc le
// comportement est inchangé pour ces cas.
model ListingAvailability {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId   String   @db.Uuid
  startDate   DateTime
  endDate     DateTime // exclusif, même convention que Booking
  isAvailable Boolean  @default(true)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// Règle de disponibilité récurrente hebdomadaire — uniquement pertinente pour
// Listing.pricingUnit = HOUR. Une annonce peut avoir plusieurs règles (ex. horaires
// différents lun-ven vs samedi). ListingAvailability (ci-dessus) reste le mécanisme
// pour les exceptions ponctuelles (fermeture, blocage manuel d'un créneau).
//
// Générateur de créneaux (front + back) : pour un jour donné, on prend les règles dont
// dayOfWeek correspond, on découpe [startTime, endTime] en tranches de minDurationMinutes,
// on retire tout ce qui chevauche une ListingAvailability(isAvailable=false) ou un Booking
// existant (PENDING/CONFIRMED), et on retire les créneaux commençant avant
// now() + minLeadTimeMinutes.
model ListingAvailabilityRule {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String @db.Uuid

  dayOfWeek Int // 0 = dimanche ... 6 = samedi (convention JS Date#getDay())

  startTime String // "08:00" — heure locale, format HH:mm
  endTime   String // "19:00"

  minDurationMinutes  Int @default(60)
  minLeadTimeMinutes  Int @default(0) // délai minimum avant réservation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, dayOfWeek])
}

// ─── BOOKINGS ─────────────────────────────────────────────────────────────────

model Booking {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String        @db.Uuid
  tenantId  String        @db.Uuid
  status    BookingStatus @default(PENDING)

  // Convention endDate EXCLUSIF : la réservation couvre [startDate, endDate[.
  // Exemple (pricingUnit = NIGHT) : du 10 au 12 juillet = startDate 2024-07-10, endDate 2024-07-12 → 2 nuits.
  // Exemple (pricingUnit = HOUR)  : startDate 2024-07-10T14:00, endDate 2024-07-10T16:00 → 2 heures.
  //
  // Champ DateTime (et non @db.Date) depuis la migration 0005 : nécessaire pour porter
  // l'heure exacte des réservations horaires. Pour NIGHT/DAY, l'heure est ignorée par
  // PricingService mais reste à 00:00 par convention (posée par le front).
  // Contrainte CHECK (startDate < endDate) garantie en migration brute (0003).
  // Contrainte anti-chevauchement : voir migration 0005 (tsrange, remplace le daterange de 0003
  // pour les annonces pricingUnit = HOUR).
  startDate DateTime
  endDate   DateTime

  // unitCount = nombre d'unités facturées (nuits, heures ou jours).
  // L'interprétation dépend de Listing.pricingUnit — pas de champ redondant "nights".
  unitCount Int

  // ── Snapshot financier ──────────────────────────────────────────────────────
  // Ces montants sont figés au moment où la réservation passe en CONFIRMED.
  // Ils ne changent pas si l'hôte modifie son annonce après coup.
  //
  // Booking.serviceFee : montant calculé par la logique métier au moment de la réservation.
  // Payment.platformFee : montant effectivement prélevé par Stripe lors de la capture.
  // Les deux coexistent volontairement — voir ARCHITECTURE.md §"Booking vs Payment".
  baseAmount  Decimal @db.Decimal(10, 2)
  cleaningFee Decimal @db.Decimal(10, 2) @default(0)
  serviceFee  Decimal @db.Decimal(10, 2)
  taxAmount   Decimal @db.Decimal(10, 2) @default(0)
  totalAmount Decimal @db.Decimal(10, 2)

  guestCount  Int     @default(1)
  guestNote   String? // message / instructions libres du locataire pour l'hôte (facultatif)
  arrivalTime String? // heure d'arrivée prévue (ex. "14:30") — indicatif, distinct du créneau réservé

  // Activité/usage déclaré par le locataire. Obligatoire côté validation applicative
  // quand Listing.instantBookEnabled = false — c'est sur cette base que l'hôte accepte/refuse.
  // Distinct de guestNote (qui reste un message libre optionnel).
  activityDescription String?

  // Confirmation du locataire qu'il dispose d'une RC Pro en cours de validité.
  // Doit être true avant paiement si Listing.rcProRequired = true (vérifié en service).
  rcProConfirmed Boolean @default(false)

  // Acceptation du règlement intérieur de l'annonce (Listing.houseRules).
  // Toujours requis si Listing.houseRules est renseigné.
  houseRulesAccepted Boolean @default(false)

  // Horodatage du check-in / check-out réel, saisis par le locataire (confirmation manuelle).
  // Alimentent les rappels automatiques et l'historique "en cours" / "passée" côté front.
  checkedInAt  DateTime?
  checkedOutAt DateTime?

  // Motif de refus saisi par l'hôte — affiché au locataire. Obligatoire à la rejection
  // (voir BookingsService.reject). Null pour toute autre transition de statut.
  rejectionReason String?

  // Deadline de validation hôte. Null si Listing.instantBookEnabled = true.
  // Calculé à la création : now() + PlatformConfig.hostApprovalWindowHours.
  // Le job de nettoyage annule les PENDING dont hostApprovalDeadline est dépassée.
  hostApprovalDeadline DateTime?

  // Horodatage de l'approbation hôte — posé même si le paiement n'a pas encore
  // eu lieu (le locataire a pu ne pas encore payer au moment de l'approbation).
  // Permet de distinguer « en attente de l'hôte » de « approuvée, en attente de
  // votre paiement » côté locataire. Voir BookingsService.approve.
  hostApprovedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing  Listing   @relation(fields: [listingId], references: [id])
  tenant   User      @relation("TenantBookings", fields: [tenantId], references: [id])
  payment  Payment?
  deposit  Deposit?
  messages Message[]
  reviews  Review[]

  @@index([listingId])
  @@index([tenantId])
  @@index([status])
  @@index([listingId, startDate, endDate])
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

model Payment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String        @unique @db.Uuid
  status    PaymentStatus @default(PENDING)

  stripePaymentIntentId String? @unique
  stripeTransferId      String? // Transfer Stripe vers le compte Connect de l'hôte
  stripeRefundId        String?

  amount         Decimal @db.Decimal(10, 2) // = Booking.totalAmount
  platformFee    Decimal @db.Decimal(10, 2) // commission effectivement prélevée par Stripe
  hostPayout     Decimal @db.Decimal(10, 2) // = amount - platformFee (net reçu par l'hôte)
  refundedAmount Decimal @db.Decimal(10, 2) @default(0)

  currency   String    @default("EUR")
  capturedAt DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ─── CAUTION (DEPOSIT) ────────────────────────────────────────────────────────
// Pré-autorisation bancaire distincte du paiement du séjour — voir
// note-technique-caution.md. Une ligne n'existe que si Listing.depositAmount
// était renseigné au moment de la réservation.
model Deposit {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String        @unique @db.Uuid
  status    DepositStatus @default(AUTHORIZED)

  amount Decimal @db.Decimal(10, 2) // montant de l'empreinte posée

  stripePaymentIntentId String? @unique // PaymentIntent dédié, capture_method "manual"

  authorizedAt DateTime? // pose de l'empreinte
  expiresAt    DateTime? // durée de vie donnée par Stripe (~7 jours) — sert au job de renouvellement

  // ── Réclamation hôte ─────────────────────────────────────────────────────
  captureReason      String?  // motif : dégradation, no-show, retard, dépassement…
  captureRequestedAt DateTime? // point de départ du délai de contestation (48h)
  proofUrls          String[] @default([]) // preuves photo jointes par l'hôte

  // ── Résolution ───────────────────────────────────────────────────────────
  capturedAmount Decimal?  @db.Decimal(10, 2) // montant réellement capturé (≤ amount)
  capturedAt     DateTime?
  contestReason  String? // motif de contestation du locataire
  contestedAt    DateTime?
  releasedAt     DateTime? // libération sans capture

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([status])
}

// ─── MESSAGING ────────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String?  @unique @db.Uuid // null = conversation pré-réservation (question sur l'annonce)
  listingId String   @db.Uuid
  tenantId  String   @db.Uuid
  hostId    String   @db.Uuid
  createdAt DateTime @default(now())

  messages Message[]
  listing  Listing @relation(fields: [listingId], references: [id])
  tenant   User    @relation("ConversationTenant", fields: [tenantId], references: [id])
  host     User    @relation("ConversationHost", fields: [hostId], references: [id])

  @@index([tenantId])
  @@index([hostId])
  @@index([listingId])
}

model Message {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String            @db.Uuid
  senderId       String            @db.Uuid
  senderRole     MessageSenderRole
  content        String
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  bookingId      String?           @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
  booking      Booking?     @relation(fields: [bookingId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

// ─── REVIEWS ──────────────────────────────────────────────────────────────────

model Review {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String       @db.Uuid
  authorId  String       @db.Uuid
  target    ReviewTarget

  rating   Int     // 1 à 5 — validé au niveau applicatif (1 ≤ rating ≤ 5)
  comment  String?
  isPublic Boolean @default(true)

  // Relation polymorphique : exactement l'un des deux est non-null selon target.
  //   target = LISTING → listingId non-null, tenantSubjectId null
  //   target = TENANT  → tenantSubjectId non-null, listingId null
  // Invariant vérifié au niveau service, pas de contrainte CHECK en base
  // (PostgreSQL ne supporte pas les CHECK inter-colonnes avec FK).
  listingId       String? @db.Uuid
  tenantSubjectId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking       Booking  @relation(fields: [bookingId], references: [id])
  author        User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  listing       Listing? @relation(fields: [listingId], references: [id])
  tenantSubject User?    @relation("ReviewSubject", fields: [tenantSubjectId], references: [id])

  // Un seul avis par booking et par direction (locataire→local ou hôte→locataire)
  @@unique([bookingId, authorId, target])
  @@index([bookingId])
  @@index([authorId])
  @@index([listingId])
}
