# Variables du service API en production (Railway → service "api" → Variables).
# Ne rien committer de réel : ce fichier n'est qu'un modèle.

# ── Fournies par les services Railway (références) ───────────────────────────
DATABASE_URL="${{Postgres.DATABASE_URL}}"
REDIS_URL="${{Redis.REDIS_URL}}"

# ── Obligatoire ─────────────────────────────────────────────────────────────
NODE_ENV="production"
# Générer : openssl rand -hex 32
JWT_ACCESS_SECRET="__CHANGER__"
JWT_REFRESH_SECRET="__CHANGER__"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# URL publique du front (CORS). À renseigner APRÈS avoir généré le domaine du service web.
FRONTEND_URL="https://avenloc-web.up.railway.app"
# URL publique de l'API elle-même (sert à construire les URLs des fichiers uploadés).
API_PUBLIC_URL="https://avenloc-api.up.railway.app"

# ── Démo : contourne Stripe (onboarding + encaissement fictifs) ─────────────
FEATURES="simulatePayments"
FEATURES_ADMIN="true"

# ── Stripe (optionnel en démo — laisser vide pour rester en simulation) ─────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Google OAuth (optionnel — sinon le bouton « Continuer avec Google » est inactif) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://avenloc-api.up.railway.app/api/v1/auth/google/callback"

# ── Uploads : volume Railway monté sur /data (voir DEPLOY.md) ───────────────
UPLOADS_DIR="/data/uploads"

# ── Seed : true au premier déploiement pour créer les données de démo ───────
SEED_ON_INIT="true"
